<Window x:Class="FondoClaro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FondoClaro" Height="850" Width="1120" MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#080E18" Foreground="{StaticResource Ink}">
  <Grid Margin="28">
    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="FONDOCLARO" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" />
      <TextBlock Text="Tu imagen, bien puesta." FontSize="30" FontWeight="SemiBold" Margin="0,12,0,8" />
      <TextBlock Text="Adapta imágenes sin estirarlas y usa páginas HTML como fondo de escritorio." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
      <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,26,0,0">
        <StackPanel>
          <TextBlock Text="CONTENIDO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
          <TextBlock x:Name="FileName" Text="Todavía no has elegido un archivo" TextWrapping="Wrap" Margin="0,10,0,14" FontSize="13" />
          <Button x:Name="ChooseImageButton" Content="Elegir archivo de fondo" Click="ChooseImage_Click" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="AJUSTE PARA IMÁGENES" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
          <RadioButton x:Name="FitMode" GroupName="Fit" IsChecked="True" Content="Ajustar · imagen completa + fondo suave" Margin="0,13,0,0" Checked="FitMode_Checked" />
          <RadioButton x:Name="FillMode" GroupName="Fit" Content="Rellenar · ocupa la pantalla, recorta bordes" Margin="0,10,0,0" Checked="FillMode_Checked" />
          <TextBlock Text="La proporción se conserva en ambos modos." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="TRANSICIÓN DE IMÁGENES" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
          <Button x:Name="ChooseTransitionButton" Content="Elegir imágenes" Click="ChooseTransition_Click" Margin="0,12,0,0" />
          <TextBlock x:Name="TransitionFilesLabel" Text="Sin imágenes seleccionadas" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12" />
          <TextBlock Text="Tiempo entre cambios" Foreground="{StaticResource Muted}" FontSize="12" />
          <ComboBox x:Name="TimingModeCombo" SelectedIndex="0" Margin="0,6,0,0" SelectionChanged="TimingMode_Changed">
            <ComboBoxItem Content="Manual" />
            <ComboBoxItem Content="Automático · 5 minutos" />
          </ComboBox>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox x:Name="IntervalValueBox" Grid.Column="0" Text="30" VerticalContentAlignment="Center" Padding="10,8" />
            <ComboBox x:Name="IntervalUnitCombo" Grid.Column="2" SelectedIndex="0">
              <ComboBoxItem Content="segundos" />
              <ComboBoxItem Content="minutos" />
              <ComboBoxItem Content="horas" />
              <ComboBoxItem Content="días" />
            </ComboBox>
          </Grid>
          <TextBlock x:Name="CountdownText" Text="Transición detenida" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,11,0,0" />
          <Button x:Name="StartTransitionButton" Content="Iniciar transición" Click="StartTransition_Click" Margin="0,10,0,0" Background="#117A68" BorderBrush="#22A88F" IsEnabled="False" />
          <Button x:Name="PauseTransitionButton" Content="Pausar transición" Click="PauseTransition_Click" Margin="0,8,0,0" IsEnabled="False" />
          <Button x:Name="RemoveTransitionButton" Content="Eliminar transición" Click="RemoveTransition_Click" Margin="0,8,0,0" IsEnabled="False" />
        </StackPanel>
      </Border>
      <Button x:Name="ApplyButton" Content="Aplicar al escritorio" Click="Apply_Click" Margin="0,18,0,0" Background="#117A68" BorderBrush="#22A88F" FontWeight="SemiBold" />
      <Button x:Name="ToggleHtmlButton" Content="Pausar fondo" Click="ToggleHtml_Click" Margin="0,9,0,0" IsEnabled="False" />
      <Button x:Name="SendBackButton" Content="Enviar detrás de las apps" Click="SendBack_Click" Margin="0,9,0,0" IsEnabled="False" />
      <Button x:Name="BringFrontButton" Content="Traer delante de las apps" Click="BringFront_Click" Margin="0,9,0,0" IsEnabled="False" />
      <Button x:Name="RemoveBackgroundButton" Content="Eliminar fondo" Click="RemoveBackground_Click" Margin="0,9,0,0" IsEnabled="False" />
      <TextBlock x:Name="StatusText" Text="Ajuste local sin procesos en segundo plano." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,11,0,0" />
      <TextBlock Text="Imágenes: decodificador de Windows. SVG, PDF, HTML y video: WebView2 si puede abrirlos." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    </ScrollViewer>
    <Border Grid.Column="2" Background="#0C1422" CornerRadius="22" BorderBrush="#1C2A3E" BorderThickness="1" Padding="12">
      <Grid x:Name="PreviewRoot" ClipToBounds="True" Background="#0A1120">
        <Image x:Name="PreviewBackground" Stretch="UniformToFill" Opacity="0.75" />
        <Border Background="#050817" Opacity="0.14" />
        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="28" />
        <wv2:WebView2 x:Name="PreviewWeb" Visibility="Collapsed" />
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16" Padding="10,7" Background="#BB101827" CornerRadius="9">
          <TextBlock x:Name="PreviewLabel" Text="VISTA PREVIA" FontSize="10" FontWeight="Bold" Foreground="#D8E4F2" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
