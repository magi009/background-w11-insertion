<Window x:Class="FondoClaro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FondoClaro" Height="760" Width="1120" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#080E18" Foreground="{StaticResource Ink}">
  <Grid Margin="28">
    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
      <TextBlock Text="FONDOCLARO" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" />
      <TextBlock Text="Tu imagen, bien puesta." FontSize="30" FontWeight="SemiBold" Margin="0,12,0,8" />
      <TextBlock Text="Adapta imágenes sin estirarlas y usa páginas HTML como fondo de escritorio." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
      <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,26,0,0">
        <StackPanel>
          <TextBlock Text="CONTENIDO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
          <TextBlock x:Name="FileName" Text="Todavía no has elegido un archivo" TextWrapping="Wrap" Margin="0,10,0,14" FontSize="13" />
          <Button x:Name="ChooseImageButton" Content="Elegir archivo de fondo" Click="ChooseImage_Click" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="AJUSTE PARA IMÁGENES" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
          <RadioButton x:Name="FitMode" GroupName="Fit" IsChecked="True" Content="Ajustar · imagen completa + fondo suave" Margin="0,13,0,0" Checked="FitMode_Checked" />
          <RadioButton x:Name="FillMode" GroupName="Fit" Content="Rellenar · ocupa la pantalla, recorta bordes" Margin="0,10,0,0" Checked="FillMode_Checked" />
          <TextBlock Text="La proporción se conserva en ambos modos." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
      <Button x:Name="ApplyButton" Content="Aplicar al escritorio" Click="Apply_Click" Margin="0,18,0,0" Background="#117A68" BorderBrush="#22A88F" FontWeight="SemiBold" />
      <Button x:Name="ToggleHtmlButton" Content="Pausar HTML" Click="ToggleHtml_Click" Margin="0,9,0,0" IsEnabled="False" />
      <TextBlock x:Name="StatusText" Text="Ajuste local sin procesos en segundo plano." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,11,0,0" />
      <TextBlock Text="Imágenes: decodificador de Windows. SVG, PDF, HTML y video: WebView2 si puede abrirlos." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    <Border Grid.Column="2" Background="#0C1422" CornerRadius="22" BorderBrush="#1C2A3E" BorderThickness="1" Padding="12">
      <Grid x:Name="PreviewRoot" ClipToBounds="True" Background="#0A1120">
        <Image x:Name="PreviewBackground" Stretch="UniformToFill" Opacity="0.75" />
        <Border Background="#050817" Opacity="0.14" />
        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="28" />
        <WebView2 x:Name="PreviewWeb" Visibility="Collapsed" />
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16" Padding="10,7" Background="#BB101827" CornerRadius="9">
          <TextBlock x:Name="PreviewLabel" Text="VISTA PREVIA" FontSize="10" FontWeight="Bold" Foreground="#D8E4F2" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
